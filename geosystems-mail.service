[Unit]
Description=GeoSystems Flask Mail Service
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/html
# Contraseña de Gmail (archivo privado, permisos 600, NO está en GitHub)
EnvironmentFile=/etc/geosystems-mail.env
ExecStart=/usr/local/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 send:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
